{
  "name": "Post",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "dek": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "body_es": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "note_es": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audio_url": {
      "type": "string"
    },
    "audio_title": {
      "type": "string"
    },
    "bandcamp_album_id": {
      "type": "string"
    },
    "external_url": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}